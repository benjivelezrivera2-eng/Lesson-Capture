{
  "manifest_version": 3,
  "name": "Local Lesson Capture Helper",
  "version": "1.5.0",
  "key": "",
  "description": "Captures authorized lesson audio and video locally for personal notes.",
  "permissions": ["activeTab", "alarms", "debugger", "tabs", "storage", "notifications", "nativeMessaging", "scripting"],
  "host_permissions": [
    "https://app.jointherealworld.com/*",
    "https://*.cloudflarestream.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://app.jointherealworld.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
